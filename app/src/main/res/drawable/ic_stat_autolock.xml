<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon matching the app launcher icon (padlock + parametric-pixel keyhole).
     Android renders small icons as a white alpha mask; the keyhole pixels are carved out via evenOdd. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.4"
        android:scaleY="1.4"
        android:pivotX="54"
        android:pivotY="55">
        <!-- shackle (padlock loop), matching the launcher icon -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M41,50 V41 a13,13 0 0 1 26,0 V50" />
        <!-- body with the parametric-pixel keyhole punched out (evenOdd) -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M38,50 h32 a7,7 0 0 1 7,7 v22 a7,7 0 0 1 -7,7 h-32 a7,7 0 0 1 -7,-7 v-22 a7,7 0 0 1 7,-7 z M45,61 h4 v4 h-4 z M52,61 h4 v4 h-4 z M59,61 h4 v4 h-4 z M45,68 h4 v4 h-4 z M52,68 h4 v4 h-4 z M59,68 h4 v4 h-4 z M45,75 h4 v4 h-4 z M52,75 h4 v4 h-4 z M59,75 h4 v4 h-4 z" />
    </group>
</vector>
