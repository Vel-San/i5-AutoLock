<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar notification icon: a bold padlock that fills the 24dp canvas.
     Android renders small icons as a white alpha mask, so paths are opaque white. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- shackle (padlock loop) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6,11 V8 a6,6 0 0 1 12,0 V11 h-2.6 V8 a3.4,3.4 0 0 0 -6.8,0 V11 Z" />
    <!-- body with a punched-out keyhole (evenOdd carves the hole) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M4,10.5 h16 a2.2,2.2 0 0 1 2.2,2.2 v7.6 a2.2,2.2 0 0 1 -2.2,2.2 h-16 a2.2,2.2 0 0 1 -2.2,-2.2 v-7.6 a2.2,2.2 0 0 1 2.2,-2.2 z M12,13.6 a1.9,1.9 0 0 0 -1,3.5 V19.4 h2 v-2.3 a1.9,1.9 0 0 0 -1,-3.5 z" />
</vector>
